{
  "name": "movie-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && start-server-and-test 'USE_MOCK=true MOCK_DATASET=default MOCK_LANGUAGE=ja next start -p 3300' http://localhost:3300 'cypress run --browser chrome'",
    "cypress:open": "next build && start-server-and-test 'USE_MOCK=true MOCK_DATASET=default MOCK_LANGUAGE=ja next start -p 3300' http://localhost:3300 'cypress open'"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@js-temporal/polyfill": "^0.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.1.1",
    "shadcn": "^4.21.4",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
